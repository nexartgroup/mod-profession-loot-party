#
# mod-profession-loot-party
# Independent profession gathering loot for group members
#

[ProfessionLootParty]

# Enable/disable the module
ProfessionLootParty.Enable = 1

# Enable independent Mining loot rolls
ProfessionLootParty.Mining = 1

# Enable independent Herbalism loot rolls
ProfessionLootParty.Herbalism = 1

# Enable independent Skinning loot rolls
ProfessionLootParty.Skinning = 0

# Maximum distance in yards between the gathering player
# and an eligible group member.
ProfessionLootParty.Distance = 100

# Include raid members
ProfessionLootParty.Raid = 1

# Require the player to have enough skill for the node.
ProfessionLootParty.RequireSkill = 1

# Write debug information to the server log.
ProfessionLootParty.Debug = 0